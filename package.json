{
  "name": "email-material-requests",
  "version": "0.1.0",
  "description": "Sistema que lê e-mails de requisição de materiais e cria pedidos automaticamente",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "email",
    "orders",
    "automation"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mssql": "^11.0.1",
    "googleapis": "^148.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mssql": "^9.1.7",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "5.0.4",
    "vitest": "^3.0.9"
  }
}
