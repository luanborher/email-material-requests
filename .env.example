# Application
NODE_ENV=development
PORT=3000

# SQL Server (Docker — mesma senha do docker-compose.yml)
DB_SERVER=localhost
DB_PORT=14333
DB_DATABASE=email_material_requests
DB_USER=sa
DB_PASSWORD=EmailMaterial@123
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Email polling
EMAIL_POLL_INTERVAL_MS=60000

# Gmail API (required on Task 3)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_USER_EMAIL=seu-email@gmail.com
# GMAIL_REFRESH_TOKEN=

# Order system integration (required on Task 6)
# ORDER_SYSTEM_API_URL=https://api.example.com/orders
# ORDER_SYSTEM_API_KEY=your-api-key-here

# AI / NLP fallback parser (Task 5)
AI_PROVIDER=gemini
GEMINI_API_KEY=sua-chave-aqui
GEMINI_MODEL=gemini-2.0-flash-lite
AI_CONFIDENCE_THRESHOLD=0.7

# Alternativa: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
