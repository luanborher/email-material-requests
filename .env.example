# Application
NODE_ENV=development
PORT=3000

# SQL Server (Docker — mesma senha do docker-compose.yml)
DB_SERVER=localhost
DB_PORT=14333
DB_DATABASE=email_material_requests
DB_USER=sa
DB_PASSWORD=EmailMaterial@123
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Email polling / worker
EMAIL_POLL_INTERVAL_MS=60000
WORKER_ENABLED=true
WORKER_MAX_MESSAGES_PER_POLL=10

# Gmail API (required on Task 3)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_USER_EMAIL=seu-email@gmail.com
# GMAIL_REFRESH_TOKEN=

# Order system integration (optional — não usado neste projeto)

# AI / NLP fallback parser (Task 5 — Ollama local)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_CONFIDENCE_THRESHOLD=0.7
